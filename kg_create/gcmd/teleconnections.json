    "definitions": [
        {
            "text": "A linkage between weather changes occuring in widely seperated regions of theglobe.\nThe term 'teleconnections' is most commonly applied to variability on monthlyor longer timescales and refers to the fact that such correlations suggest thatinformation is propagating between distant points through the atmosphere.",
            "reference": "Amercan Metrological Society, 2000. The Glossary of Meteorology, 2nd ed., Boston, MA"
        }
